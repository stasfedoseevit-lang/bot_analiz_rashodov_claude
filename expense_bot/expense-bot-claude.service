[Unit]
Description=Telegram-бот учёта трат (Claude)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/root/expense_bot_test
ExecStart=/root/expense_bot_test/venv/bin/python bot.py
Environment=PYTHONUTF8=1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
