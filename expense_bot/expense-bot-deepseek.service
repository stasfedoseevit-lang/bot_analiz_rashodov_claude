[Unit]
Description=Telegram-бот учёта трат (DeepSeek)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/root/expense_bot_deepseek
ExecStart=/root/expense_bot_deepseek/venv/bin/python bot.py
Environment=PYTHONUTF8=1
Restart=always
RestartSec=10
# Защита: бот может писать только в свою папку, без повышения прав
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/expense_bot_deepseek

[Install]
WantedBy=multi-user.target
